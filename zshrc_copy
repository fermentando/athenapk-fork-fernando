# Increase history file size
HISTSIZE=1000000             # Number of commands in memory
SAVEHIST=2000000             # Number of commands to save to file
HISTFILE=~/.zsh_history      # History file location

# Share history across terminals in real-time
setopt SHARE_HISTORY         # Share history instantly across sessions
setopt INC_APPEND_HISTORY    # Append to the history file immediately
setopt HIST_IGNORE_ALL_DUPS  # Don’t store duplicate commands
setopt HIST_REDUCE_BLANKS    # Remove superfluous whitespace
setopt EXTENDED_HISTORY      # Timestamp each command

function hist_since() {
  local ts=$(date -j -f "%Y-%m-%d %H:%M:%S" "$1" +%s 2>/dev/null)
  if [[ -z "$ts" ]]; then
    echo "❌ Invalid date format. Use: YYYY-MM-DD HH:MM:SS"
    return 1
  fi

  awk -v ts="$ts" '
    {
      if ($0 ~ /^:/) {
        split($0, a, ":")
        time = a[2]
        getline cmd
        if (time >= ts) {
          print time " - " cmd
        }
      }
    }
  ' ~/.zsh_history
}


